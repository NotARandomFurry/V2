							BloodMoonHaircut: (Player) asked for a haircut at just the right time.
							Hardcore:
								'''
								{Player} snackrificed their only life to its rightful holder: {Pred} the hair stylist.
								May they find endless enjoyment as stylish stomach fat.
								'''
						}

						Succubus: {
							1: "{Player} was forced to fatten up {Pred}'s demonic derriere."
							2: "{Player}'s body is now stored on {Pred}'s hellish hips."
							3: "{Pred} is one step closer to being the fattest demon in the world, thanks to {Player}."
							4: "{Player} helped thicken up {Pred}'s satanic sides even further."
							5: "{Pred} promised {Player} a fun time...and figured that a night of hanging off her midsection counts."

							StomachSuffocation: {
								1: "{Player}'s lungs couldn't handle {Pred}'s infernal internals."
								2: "{Pred}'s searing stomach scorched {Player}'s respiratory system."
							}

							Hardcore:
								'''
								{Player}'s body and soul alike were churned into some new chest fat for {Pred}.
								Maybe now, she'll be able to use that strength to become the apex pred she's wanted to be.
								'''
						}

						Mechanic: {
							1: '''{Pred}'s system converted {Player} into "potential energy".'''
							2: "{Player} helped to recharge {Pred}'s batteries."
							3: "{Pred} took a snack break with {Player}."
							4: "{Pred}'s system caused {Player} to short-circuit."
							5: "{Player} suffered a blackout in {Pred}'s stomach."
							6: "{Player} was fixed."
							7: "{Player} was scrapped."
							8: "{Player} was turned into a battery by {Pred}."
							Hardcore: "{Player} has become the best battery {Pred}'s ever used, at the cost of their continued existence."
						}

						PartyGirl: {
							1: "{Pred} had {Player} as a pre-party pick-me-up."
							2: "{Player} will be the life of the party as {Pred}'s tum fat."
							3: "{Pred} thought {Player} tasted...almost as good as candy."
							4: "{Pred} melted {Player} into liquid confetti."
							5: "{Player} partied too hard in {Pred}'s belly."
							6: "{Player} was sloshed to the beat of the drums by {Pred}."
							Hardcore:
								'''
								The last anyone ever saw of {Player} was a breathy, bubbly belch from {Pred}, bringing up a bundle of heated, half-liquid confetti.
								At least the gut fat they left on her will keep her the life of the party for many weeks to come.
								'''
						}

						Steampunker: {
							1: "{Pred} needed fuel for her engine; fuel which {Player} was all too eager to provide."
							2: "{Player} was flawlessly converted to steam inside {Pred}'s mechanisms."
							3: "{Pred} fed {Player} into her countless internal devices and doohickeys."
							4: "{Pred} hid {Player} away in her stomach, never to see the sun again."
							5: "{Player} wanted to know how steam is made. {Pred} happily demonstrated."
							6: The only thing left of {Player} is a gutful of steam inside {Pred}.
							7: "{Pred}'s body has become a little bit denser, thanks to {Prey}."
							Hardcore:
								'''
								No conclusive evidence will ever be found of where {Player}'s one life disappeared to.
								The only clue left behind? {Pred} having higher density than usual and belching up a healthy amount of steam.
								'''
						}
					}

					Bosses: {
						UnreasonablyThickFairy: {
							1: "{Player} became a light snack for the Empress."
							2: The Empress' gut blinded {Player} just a little too long.
							3: "{Player} was too enamored by the Empress' shiny stomach walls to fight their way out."
							Hardcore:
								'''
								{Player} was, sadly, far too enamored by the Empress' mesmerizingly twinkly tummy walls to fight their way out.
								The only evidence left of their only chance at existence will be a fresh new layer of fat on her already-thick thighs.
								'''
						}
					}
				}
			}

			OverlyHungryPlayer: {
