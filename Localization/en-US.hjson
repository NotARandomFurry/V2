			Voraria: {
				Charms: {
					BetterDigestion: {
						Short:
							'''
							Makes your acids a little bit stronger
							{$Mods.V2.ItemTooltip.Generic.HoldSHIFTToLearnWhatTheFuckYourItemDoes}
							'''
						Long:
							'''
							Increases your [c/00FF00:acid strength stat (ACI)] by [c/FFFF00:12].
							'''
					}
					RegenFromAbsorption: {
						Short:
							'''
							Grants health and mana regeneration while digesting dead prey
							{$Mods.V2.ItemTooltip.Generic.HoldSHIFTToLearnWhatTheFuckYourItemDoes}
							'''
						Long:
							'''
							While digesting dead prey, your [c/FF7F7F:health] and [c/7F7FFF:mana] are regenerated proportional to your [c/3FBF3F:absorption rate].
							Each prey in your belly still alive makes this [c/BF3F3F:less effective], proportional to how much of your absorption rate they take up.
							The following equation represents the regeneration per second as a function of your absorption rate:
							[c/FF7F7F:Regen Per Second] = [c/3FDF3F:Absorption Rate] * [c/DFDF3F:60]
							The following equation represents the effectiveness of the regeneration:
							[c/FF7F7F:Regen Multiplier] = [c/3FDF3F:Dead Prey In Stomach] / [c/3FDF3F:Total Prey In Stomach]
							
							Base Regeneration: [c/FFFF00:{BaseRegen}] [c/FF7F7F:health] and [c/7F7FFF:mana] per 1.0 prey unit digested
							Max Regeneration: [c/FFFF00:{MaxRegen}] [c/FF7F7F:health] and [c/7F7FFF:mana] per second
							Current Regeneration: [c/FFFF00:{CurrentRegen}] [c/FF7F7F:health] and [c/7F7FFF:mana] per second
							'''
					}
				}
			}
		}
