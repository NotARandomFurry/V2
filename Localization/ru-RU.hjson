		Keybinds: {
			Swallow.DisplayName: Проглоти
			Regurgitate.DisplayName: Срыгивать
			Feed.DisplayName: Скормить
			EatItems.DisplayName: Проглотить предмет
			StruggleUp.DisplayName: Борьба вверх
			StruggleLeft.DisplayName: Борьба влево
			StruggleRight.DisplayName: Борьба право
			StruggleDown.DisplayName: Борьба вниз
			StruggleSpecial.DisplayName: Специальная борьба
			// RespawnAfterDigestion.DisplayName: Respawn After Digestion
		}

		Conditions: {
			FullNPC: Если наполненность желудка NPC в магазине составляет 0,75 или выше
			BeginnerStatPoints: Если вы заработали 10 или более очков статистики за счет хищных голов
		}

		Configs: {
			V2ServerConfig.DisplayName: Параметры сервера
			// V2ClientConfig.DisplayName: Client-Side Options

			Server: {
				Insight: {
					Header:
						'''
						Параметры понимания
						[c/7F7F7F:(Они позволяют вам проще создавать отчеты об ошибках и другие подобные вещи)]
						'''

					DebugChatMessages: {
						Label: Отправка сообщений в чате отладки
						Tooltip:
							'''
							Отображает в чате отладочные сообщения, связанные с различными механиками vore.
							Заметьте, что они могут... нет, ХОТЯТ спамить ваш чат, и их следует включать только в том случае, если что-то не так.
							Это может существенно помочь в устранении ошибок.
							По умолчанию значение false.
							'''
					}
				}

				Personalization: {
					Header:
						'''
						Опции персонализации
						[c/7F7F7F:(Они позволят вам настроить игру в соответствии с вашими предпочтениями, не нарушая баланс игры)]
						'''

					RandomGulpsAgainstPlayers: {
						Label: Горожане Тумскары
						Tooltip:
							'''
							Позволяет жителям города случайным образом поедать ближайших игроков.
							Не влияет на горожан, случайно поедающих друг друга.
							По умолчанию значение false.
							'''
					}

					GenderBlacklist: {
						Label: Непредпочтение хищника
						Tooltip:
							'''
							Позволяет запретить хищникам определенного пола активно поедать других в игре.
							Как правило, это касается всех субъектов, включая игроков. Однако:
							- Не затрагивает никакие внутривселенские установления о хищниках пола, занесенного в черный список.
							- Не работает для гермафродитов, андрогинных угроз и прочих функционально бесполых особей.
							- Определенные могущественные организации оставляют за собой право и возможность полностью обойти любой черный список, созданный с помощью этой опции.
							По умолчанию не включает в черный список ни один пол.
							'''
					}
				}

				JustForFun: {
					Header:
						'''
						Опции просто для удовольствия
						[c/7F7F7F:(они позволят вам сказать моим балансовым намерениям идти нахуй и просто тупо развлекаться в игре.)]
						'''

					DefenseInDigestionCalcs: {
						Label: Включите защиту в расчеты ущерба пищеварению
						Tooltip:
							'''
							НАРУШЕНИЕ БАЛАНСА: Высокий
							Определяет, влияет ли защита на урон от пищеварения.
							Это касается всех хищников, а не только игроков.
							По умолчанию установлено значение true.
							'''
					}

					EasilyEdibleEmpress: {
						Label: Привлечение второго закона
						Tooltip:
							'''
							СБАЛАНСИРОВАННОЕ РАЗРУШЕНИЕ: Кому это важно?
							Позволяет Императрице Света проникать в глотки любой силы, в желудки любой вместимости и значительно увеличивает урон от пищеварения.
							По умолчанию значение false.
							'Феи - это еда. Они могут быть друзьями или врагами, даже сытыми или откормленными другой едой, но они ВСЕГДА еда. Исключения очень редки'.
							'''
					}

					PermaChurnableEquipment: {
						// Label: Perma-Gurgled Possessions
						/* Tooltip:
							'''
							BALANCE BREAKAGE: Varies
							When an item equipped by a Softcore or Journey character reaches 0 durability from indirect digestion damage:
							- If set to false, it becomes non-functional and must be repaired.
							- If set to true, it is properly churned into nothing just as its owner soon will be.
							Defaults to false.
							''' */
					}

					FatAssesBreakTiles: {
						// Label: Fatasses Break Tiles
						/* Tooltip:
							'''
							BALANCE BREAKAGE: None
							Allows really fuckin' fat things to break tiles below them if they aren't on flat ground. Platforms & glass break easier.
							Defaults to true.
							''' */
					}
				}
			}

			Client: {
				Visual: {
					/* Header:
						'''
						Visual Options
						[c/7F7F7F:(these let you tinker with how exactly certain things look on your end)]
						''' */

					SkipPredStatMenuAnims: {
						// Label: Skip Pred Stat Menu's Mouth Animations
						/* Tooltip:
							'''
							Determines whether or not you see Rose's short swallow/regurgitate animations upon attempting to open or close the pred stats menu.
							Defaults to false.
							// please at least give these animations a shot first
							// I put a whole, like. several hours of work into them!
							// and Rose won't be as happy if she doesn't get to feel the satisfaction of gulpin' down your tasty cursor!
							// so please keep this one on!
							''' */
					}

					StruggleSystemBackdropType: {
						// Label: Struggle System UI Orientation
						/* Tooltip:
							'''
							Determines what orientation the struggle system's UI is displayed in.
							Defaults to using the Horizontal orientation.
							// new orientation options MAY be considered
							''' */
					}

					ShowChurnDamageNumbers: {
						// Label: Show Digestion Damage
						/* Tooltip:
							'''
							Determines whether or not you see digestion damage numbers.
							Defaults to true.
							// this shit doin' numbers?
							''' */
					}

					TheGutSlutVisionOMatic: {
						// Label: Gaze of the Gutted
						/* Tooltip:
							'''
							When a player is successfully digested by a pred, their death camera will not have a countdown before respawn.
							Instead, their death camera will follow the pred indefinitely (remaining in place if/when the pred despawns or is killed) until the B key is pressed.
							Defaults to false.
							// probably should make this one default to true later for all the gut sluts in my audience

							// because I know there are a ton of you
							''' */
					}
				}
			}

			StruggleUIOrientation: {
				// Tooltip: ""
				// Horizontal.Label: Horizontal
				// HorizontalFlipped.Label: Horizontal (Inverted)
				// FNF.Label: Upscroll
				// GuitarHero.Label: Downscroll
			}
		}

		GameTips: {
			MagicMirror:
				'''
				Если вы встретите Волшебное зеркало, его использование телепортирует вас обратно в точку возрождения...

				...обычно. Только не пытайтесь использовать его в тесных и темных помещениях.
				'''
			LavaAndObsidianSkinPotion:
				'''
				Зелья из обсидиановой кожи очень полезны при исследовании местности, где много лавы, так как позволяют купаться в ней без вреда для здоровья.
				Кроме того, они дают возможность свободно пить лаву - хотя, учтите, лава очень жирная.
				'''
			WiresFromMechanic:
				'''
				Вы можете купить провода у Механика и использовать их для создания ловушек, насосных систем, систематических фабрик по кормлению вайфу,
				или другие сложные приспособления, призванные сделать процесс приема пищи еще проще, чем он есть.
				'''
			PartyGirlNeedsLotsOfSnacksToMoveIn:
				'''
				Тусовщица не переедет к вам, пока в вашем маленьком уголке мира не будет полно других горожан.
				В конце концов, что за вечеринка без множества совершенно готовых гостей, которых можно... пригласить на нее?
				'''
			PredStats:
				'''
				У вас есть четыре стата: сила глотания (GLP), сила кислоты (ACI), сила желудка (TUM) и сила поглощения (ABS).
				Обязательно изучите, что делает каждый из них, и используйте свои сильные стороны, готовясь проглотить вселенную!
				'''
			SwallowHotkey:
				'''
				Нажав на горячую клавишу "Проглотить", находясь рядом с чем-то или кем-то, кого вы хотели бы съесть, вы можете отправить их прямо в горло!
				Только имейте в виду, что некоторые продукты не так легко укладываются на дно, как другие...
				'''
			HaveARefreshingDrink:
				'''
				Вас беспокоит огромное количество жидкости? Не волнуйтесь!
				Если во время погружения в воду удерживать клавишу Swallow, то любой освежающий напиток попадет вам прямо в горло!
				Однако имейте в виду, что некоторые напитки гораздо опаснее для вашего организма... Вам понадобятся специальные средства, чтобы сделать их безопасными для желудка.
				'''
			RegurgitateHotkey:
				'''
				Если вы обнаружите, что особенно вздорная еда доставляет вам неприятности, вы всегда можете использовать горячую клавишу Regurgitate, чтобы вернуть ее на место!

				...только убедитесь, что они не съедят вас самих после этого. Око за око - и вся планета будет замульчирована.
				'''
			FeedHotkey:
				'''
				Если вы - хищник, увидевший симпатичную кишку, в которой можно поспать, смело используйте горячую клавишу Feed, чтобы впиться в горло ее владельца.
				Только не надейтесь, что вы не превратитесь в еще больший жир для их каркаса. Большинству хищников совершенно безразлично ваше желание дремать у них в животике.
				'''
			ItemNomsHotkey:
				'''
				Чувствуете голод, но не хотите лакомиться колючими закусками вокруг? Просто загляните в свой инвентарь!
				Если удерживать клавишу Съесть предметы и нажать Проглотить при наведении на предмет, вы можете отправить его прямо себе в живот!
				Некоторые предметы также обладают уникальными эффектами при поедании и переваривании... обязательно посмотрите, что делают ваши закуски в их подсказках!
				'''
			/* YouAreNeverSafe:
				'''
				Don't ever get too comfortable with how established you are in the world!
				Anything, and we do mean ANYTHING, can eat you if you're too unlucky a prey, or too overconfident a pred.
				''' */
		}

		StruggleSystem: {
			Horiz: {
				// ThisIsThePredLane: >>> Pred
				// ThisIsThePreyLane: Prey <<<
			}

			HorizFlip: {
				// ThisIsThePredLane: >>> Prey
				// ThisIsThePreyLane: Pred <<<
			}

			FNF: {
				// ThisIsThePredLane: Pred
				// ThisIsThePreyLane: Prey
			}

			GuitarHero: {
				// ThisIsThePredLane: Pred
				// ThisIsThePreyLane: Prey
			}
		}

		PredStatsMenu: {
			StatPointHover: {
				Default:
					'''
					В данный момент у вас есть {StatPointCount} баллов, которые вы можете потратить, из {StatPointTotal} общего количества накопленных.
					[c/7F7F7F:- {GLPSpent} вложены в GLP]
					[c/7F7F7F:- {TUMSpent} вложены в TUM]
					[c/7F7F7F:- {ACISpent} вложены в ACI]
					[c/7F7F7F:- {ABSSpent} вложены в ABS]
					'''
				RoseAddon:
					'''
					Поскольку на вас надета [c/{RoseFlowerColor}:Rose's Flower Pin], вы можете прибавлять и убавлять очки по своему усмотрению, нажимая на этот элемент.
					[c/{CheatedPointAllocColor}:Щелкните левой кнопкой мыши], чтобы добавить точки; [c/{CheatedPointAllocColor}:right-click], чтобы вычесть их.
					[c/{CheatedPointAllocColor}:Удерживая только левый SHIFT] можно добавлять/вычитать очки, кратные 10.
					[c/{CheatedPointAllocColor}:Удерживая левый SHIFT + левый CONTROL], можно добавлять/вычитать очки, кратные 100.
					[c/{CheatedPointAllocColor}:Удерживайте только левую кнопку левый CONTROL], чтобы добавить/вычесть очки, равные количеству очков, заработанных вами в целях хищников игрока.

					Обманутые очки становятся  [c/{$Mods.V2.CommonColorCodes.NegativeVoreEffect}:null and void] когда вынимается булавка с цветком Розы.
					Если вы используете больше очков статов, чем могли бы после, [c/{$Mods.V2.CommonColorCodes.NegativeVoreEffect}:все вложения очков статов будут мгновенно аннулированы].

					Ваш текущий модификатор точки цветочного булавки равен [c/{$Mods.V2.CommonColorCodes.DoSomething}:{CheatedPointModifier}].
					'''
			}

			StatSliceHover: {
				Default:
					'''
					[c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:{PredStatName} ({PredStatShorthand})]
					{SpentPoints} очков, вложенных

					Левая кнопка мыши добавляет 1 очко
					Правой кнопкой мыши снять 1 очко
					[c/FFBF00:Чтобы распределить очки в наборы по 10, удерживайте левый SHIFT]
					[c/FFBF00:Чтобы распределить точки по наборам из 100, удерживай левый SHIFT и левый CONTROL]
					[c/FFBF00:Чтобы переместить все доступные точки одновременно, удерживай левую клавишу CONTROL]
					'''
				Bulk10:
					'''
					[c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:{PredStatName} ({PredStatShorthand})]
					{SpentPoints} очков, вложенных

					Левая кнопка мыши добавляет 10 очко
					Правой кнопкой мыши снять 10 очко
					[c/FFBF00:Чтобы распределить очки по отдельности, отпусти левую клавишу SHIFT]
					[c/FFBF00:Чтобы распределить точки по наборам из 100, удерживай левую клавишу CONTROL]
					[c/FFBF00:Чтобы переместить все доступные точки сразу, отпусти левую SHIFT и удерживай левую CONTROL]
					'''
				Bulk100:
					'''
					[c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:{PredStatName} ({PredStatShorthand})]
					{SpentPoints} очков, вложенных

					Левая кнопка мыши добавляет 100 очко
					Правой кнопкой мыши снять 100 очко
					[c/FFBF00:Чтобы распределить пункты по отдельности, отпусти левый SHIFT и левый CONTROL]
					[c/FFBF00:Чтобы расставить все точки в наборах по 10, отпусти левый CONTROL]
					[c/FFBF00:Чтобы переместить все доступные точки одновременно, отпусти левый SHIFT]
					'''
				BulkMaximum:
					'''
					[c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:{PredStatName} ({PredStatShorthand})]
					{SpentPoints} очков, вложенных

					Left-click to add all available points
					Right-click to remove all invested points
					[c/FFBF00:Чтобы распределить пункты по отдельности, отпусти левый SHIFT и левый CONTROL]
					[c/FFBF00:Чтобы расставить все точки в наборах по 10, отпусти левый CONTROL]
					[c/FFBF00:Чтобы распределить точки в наборы по 100, удерживай левый SHIFT]
					'''
			}

			StatDescription: {
				HoldSHIFTToSeeDescription: "[c/7F7F7F:Удерживай левую клавишу SHIFT, чтобы просмотреть более подробные описания следующих статистических данных.]"

				GLP: {
					Description:
						'''
						[c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:Сила глотания (GLP)] определяет, насколько хорошо ваше горло справляется с проглатыванием пищи и ее удержанием, пока желудок делает свое дело.

						[c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:Влияет на максимальный размер добычи, которую вы можете проглотить.]
						[c/7F7F7F:| {BaseSwallowSize} базовый.]
						[c/7F7F7F:| +{SwallowSizePerLevel} за каждое вложенное очко статов.]
						[c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:Влияет на скорость питья жидкостей.]
						[c/7F7F7F:| {BaseDrinkRate} тайлов/секунду базового.]
						[c/7F7F7F:| +{DrinkRatePer5Levels} плиток/секунду за 5 вложенных очков статов.]
						[c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:Влияет на *льготный период* борьбы после проглатывания живой добычи.]
						[c/7F7F7F:| {BaseStruggleGraceTime}сек базовый.]
						[c/7F7F7F:| +{StruggleGraceTimePer5Levels}сек за 5 вложенных очков статистики.]
						'''

					RelevantStats: {
						Normal:
							'''
							Total GLP: [c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:{GLPTotal}]
							[c/7F7F7F:| {GLPSpent} от вложенных очков статистики]
							[c/7F7F7F:| {GLPBase} от постоянных бонусов]
							[c/7F7F7F:| {GLPExtra} от временных бонусов (зелья, чары и т. д.)]

							{$Mods.V2.PredStatsMenu.StatDescription.HoldSHIFTToSeeDescription}
							Вместимость глотка: {PreySwallowSize}
							Питьевая норма: {LiquidSwallowRate} tiles/second
							Период борьбы: {StruggleGracePeriod}
							'''
						Chronological:
							'''
							Total GLP: [c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:∞]
							[c/7F7F7F:| ∞ from digesting at least one Timekeeper]

							Вместимость глотка: [c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:∞]
							Питьевая норма: [c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:Countless universes/second, should you will it]
							Период борьбы: [c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:Unnecessary]
							'''
					}
				}

				TUM: {
					Description:
						'''
						[c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:Сила желудка (TUM)] определяет, насколько хорошо ваш голодный животик справляется с тем, чтобы все те вкусности, которые вы в него запихиваете, могли быть успешно задержаны для переваривания.

						[c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:Влияет на максимальный размер вашего живота, который может быть комфортным.]
						[c/7F7F7F:| {BaseStomachCapacity} базовый]
						[c/7F7F7F:| +{StomachCapacityPerLevel} за каждое вложенное очко статистики.]
						[c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:Влияет на мощность измерителя боли в желудке.]
						[c/7F7F7F:| {BaseStomachacheMeterCapacity} базовый.]
						[c/7F7F7F:| +{StomachacheMeterCapacityPer5Levels} за 5 вложенных очков статистики.]

						IЕсли этот показатель ниже, чем общий показатель STR вашей добычи, [c/{$Mods.V2.CommonColorCodes.NegativeVoreEffect}:карты борьбы между вами и содержимым вашего живота перевешиваются против вас пропорционально разнице.]
						Если этот показатель выше, чем общий показатель STR вашей жертвы, [c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:карты борьбы между вами и содержимым вашего живота перевешиваются в вашу пользу пропорционально разнице.]
						'''

					RelevantStats: {
						Normal:
							'''
							Total TUM: [c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:{TUMTotal}]
							[c/7F7F7F:| {TUMSpent} от вложенных очков статистики]
							[c/7F7F7F:| {TUMBase} от постоянных бонусов]
							[c/7F7F7F:| {TUMExtra} от временных бонусов (зелья, чары и т.д.)]

							{$Mods.V2.PredStatsMenu.StatDescription.HoldSHIFTToSeeDescription}
							Вместительность желудка: {StomachCapacity}
							Емкость измерителя желудочной боли: {StomachacheMeterCapacity}
							Общая диаграмма сложности: {StruggleChartEstimatedDifficulty}
							'''
						Chronological:
							'''
							Total TUM: [c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:∞]
							[c/7F7F7F:| ∞ from digesting at least one Timekeeper]

							Вместительность желудка: [c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:∞]
							Емкость измерителя желудочной боли: [c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:∞]
							Общая диаграмма сложности: [c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:Даже целые вселенные не могут "бороться" внутри такого обжоры, как ты.]
							'''
					}
				}

				ACI: {
					Description:
						'''
						[c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:Сила кислоты (ACI)] определяет, насколько хорошо кислоты вашего желудка способны разъедать вашу добычу до тех пор, пока она не перестанет ее выносить и не превратится в питательный осадок в вашем кишечнике.

						[c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:Влияет на базовый урон от клещей пищеварения.]
						[c/7F7F7F:| {BaseDigestionDamage} базовый.]
						[c/7F7F7F:| +{DigestionDamagePerLevel} за каждое вложенное очко статов.]
						[c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:Влияет на скорость, с которой ваш живот наносит урон пищеварению.]
						[c/7F7F7F:| {BaseDigestionRate} тики/секундная базовая.]
						[c/7F7F7F:| +{DigestionRatePer5Levels} тик/секунду за 5 вложенных очков статистики.]

						[c/{$Mods.V2.CommonColorCodes.NegativeVoreEffect}:Некоторые предметы, такие как кости, металлы, некоторые предметы одежды и пластик, не могут быть переварены обычными желудочными кислотами]. Чтобы переварить эти предметы, вам придется либо использовать внешние вспомогательные средства для пищеварения, либо модернизировать желудочные кислоты более специализированным образом.
						'''

					RelevantStats: {
						Normal:
							'''
							Total ACI: [c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:{ACITotal}]
							[c/7F7F7F:| {ACISpent} от вложенных очков статистики]
							[c/7F7F7F:| {ACIBase} от постоянных бонусов]
							[c/7F7F7F:| {ACIExtra} от временных бонусов (зелья, чары и т.д.)]

							{$Mods.V2.PredStatsMenu.StatDescription.HoldSHIFTToSeeDescription}
							Базовый урон от переваривания: {DigestionDamage}
							Скорость пищеварения: {DigestionRate} ticks/second
							{AcidTierWithDescription}
							'''
						Chronological:
							'''
							Всего ACI: [c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:∞]
							[c/7F7F7F:| ∞ от переваривания по крайней мере одного Хранителя времени]

							Повреждение пищеварения: ∞
							Повреждение пищеварения Скорость тика: ∞/sec
							Уровень желудочной кислоты: [c/FFFF00:Chronological (∞)]
							Ваше желание поглотить весь мир, в том числе и Божественное царство, полностью исполнилось, и теперь вы, как бывший Хранитель времени, контролируете само течение времени.
							То, что когда-то было живой, дышащей вселенной с бесчисленными существами, живущими в ней, превратилось в ничто иное, как пудинг для вашего животика, но вы все равно абсолютно голодны.

							К счастью, существует практически бесконечное количество других вселенных, у которых есть одна общая цель: служить вам бесконечным источником пищи. Ваши кислоты - новая великая константа реальности, растворяющая целые пузыри существования за мгновения, стоит вам только захотеть.

							Реальность - это ваш шведский стол. Все, что существует, когда-либо существовало и когда-либо будет существовать, обречено - нет, предназначено - ...нет. Предназначено для того, чтобы со временем превратиться в жир для вашей фигуры.
							Приятного аппетита.
							'''
					}

					AcidTiers: {
						NormalBeta:
							'''
							Уровень желудочной кислоты: [c/9F9F9F:Normal (1)]
							Ваши желудочные кислоты так же обыденны, как и кислоты следующего хищника.
							[c/{$Mods.V2.CommonColorCodes.NegativeVoreEffect}:Кости, одежда и различные другие материалы легко переживут ваш голодный желудок, несмотря на все его старания растопить их.]

							[c/601818:Следующий метод кислотного обновления еще не реализован!]
							[c/C03030:Пожалуйста, подождите, пока в будущем обновлении не будет реализован следующий метод кислотного обновления.]
							'''
						Normal:
							'''
							Уровень желудочной кислоты: [c/9F9F9F:Normal (1)]
							Ваши желудочные кислоты так же обыденны, как и кислоты следующего хищника.
							[c/{$Mods.V2.CommonColorCodes.NegativeVoreEffect}:Кости, одежда и различные другие материалы легко переживут ваш голодный желудок, несмотря на все его старания растопить их.]

							По слухам, старый исследователь из Аварсичи живет под поверхностью тундры.
							Конечно, она уже в возрасте, но от этого не менее мудра и остроумна, и, возможно, сможет помочь исправить этот недостаток, но за определенную плату...
							'''
						Recursive:
							'''
							Уровень желудочной кислоты: [c/FF4FFF:Recursive (2)]
							Ваши желудочные кислоты были зачарованы на рекурсивное переваривание добычи в знак благодарности от довольно... эксцентричной феи-чародейки, живущей в карманном измерении внутри живота старого аварского исследователя космоса.
							Кости и одежда больше не могут так легко избежать своей участи быть толстыми на вашем каркасе. Однако [c/{$Mods.V2.CommonColorCodes.NegativeVoreEffect}:пластику и различным металлам по-прежнему удается с легкостью уклоняться от атаки вашего желудка.]

							Тем не менее, в комнате чародейки были объявления о товаре, который производится и продается исключительно в границах Аварсиана и может решить эту проблему...
							'''
						Royal:
							'''
							Уровень желудочной кислоты: [c/167200:Royal (3)]
							Ваши желудочные кислоты, благодаря заклинанию биоальтерации, массово производимому и продаваемому в границах Аварсичи, теперь смешиваются с азотной кислотой, образуя то, что многие называют просто "королевскими кислотами".
							Теперь практически ничто из этой плоскости не может ускользнуть от воли вашего желудка.
							Однако имейте в виду, что [c/{$Mods.V2.CommonColorCodes.NegativeVoreEffect}:различные предметы потустороннего происхождения] по-прежнему неуязвимы для вашего славного желудочно-кишечного первенства.
							Кроме того, вы по-прежнему [c/{$Mods.V2.CommonColorCodes.NegativeVoreEffect}:не можете удерживать и переваривать души своих жертв] без помощи чар или способности предсказания.

							Не существует ничего, кроме благословения божества, способного наделить вас большим пищеварительным потенциалом.
							'''
						Divine:
							'''
							Уровень желудочной кислоты: [c/167200:Divine (4)]
							По воле Мелодии, в благодарность за то, что она вернула ей ее любимого Ведущего Дирижера, вашей королевской кислоте была дарована привилегия, которой может обладать только ангел.
							Ничто не ускользнет от твоего желудка - ты можешь вместить и переварить даже не божественные души, и даже деликатесы Божественного царства не смогут переварить твою превосходную пищеварительную систему.
							Таким образом, все ваши сражения с завтраком (и другими приемами пищи) теперь превращаются в войну на истощение - в которой, если вы захотите, вам суждено победить.

							Еще больший толчок потребуется, чтобы начать переваривать души обитателей Божественного царства в своем стремлении стать вершиной и однажды, надеюсь, в скором времени, поглотить ВЕСЬ мир, в котором вы живете... но где взять такую сырую, неочищенную силу желудка, не говоря уже о силе, необходимой, чтобы пробить божественную защиту души?
							'''
					}
				}

				ABS: {
					Description:
						'''
						[c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:Сила поглощения (ABS)] определяет, насколько хорош ваш пищеварительный тракт в обеспечении того, чтобы каждый последний (перевариваемый) след вашей добычи был должным образом переработан в богатый, мягкий целлюлит, чтобы быть упакованным на поверхности вашего бездонного живота (и, конечно, любых других областей предпочтения).

						[c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:Влияет на скорость поглощения пищи организмом.]
						[c/7F7F7F:| {BaseAbsorbRate} вес/минута базовый]
						[c/7F7F7F:| +{AbsorbRatePerLevel} вес/минута на каждое вложенное очко статистики.]
						[c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:Влияет на продолжительность эффектов статуса от съеденной еды, напитков и добычи.]
						[c/7F7F7F:| Продолжительность действия баффа умножается на +{BuffExtendPer5Levels} за 5 вложенных очков статов.]
						[c/7F7F7F:| Время действия дебаффа делится на +{DebuffLossPer5Levels} за 5 вложенных очков статов.]
						'''

					RelevantStats: {
						Normal:
							'''
							Всего ABS: [c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:{ABSTotal}]
							[c/7F7F7F:| {ABSSpent} от вложенных очков статов]
							[c/7F7F7F:| {ABSBase} от постоянных бонусов]
							[c/7F7F7F:| {ABSExtra} от временных бонусов (зелья, чары и т.д.)]

							{$Mods.V2.PredStatsMenu.StatDescription.HoldSHIFTToSeeDescription}
							Скорость поглощения: {AbsorptionRate} вес/минуту
							Баффы из закусок {BuffExtensionTime} длительность
							Дебаффы от закусок {DebuffDisextensionTime} длительность
							'''
						Chronological:
							'''
							Всего ABS: [c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:∞]
							[c/7F7F7F:| ∞ от переваривания по крайней мере одного Хранителя времени]

							Скорость поглощения: ∞ weight/minute
							Баффы от съеденной добычи бесконечны и бесконечно суммируются
							Дебаффы вообще не накладываются на съеденную добычу
							'''
					}
				}
			}
		}

		PredPlayerGoals: {
			GenericText: {
				Header: {
					Title: "[c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:Голы игроков Хищников]"
					Description: Это коллекция достижений, которые вы можете выполнить, чтобы заработать  [c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:stat points]! [c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:Очки статистики] можно потратить в главном меню статистики предов, чтобы [c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:сделать вашу пищеварительную систему сильнее]. Чем больше вы выполните заданий и чем больше продвинетесь в остальной части игры, тем больше целей вы сможете увидеть!
				}

				HoldToLearnMore: {
					Incomplete: Удерживая левую клавишу SHIFT, получите более подробную информацию о том, как выполнить эту цель.
					Complete: Удерживая левую клавишу SHIFT, получите более подробную информацию о том, как вы достигли этой цели.
				}
			}

			SortingText:
				'''
				[c/{HeaderColor}:Сортировка целей на этапе]
				Вам нужно, чтобы ваши вещи были уложены аккуратно?
				Примерьте один из этих вариантов!

				- [c/{DefaultSortColor}:Внутреннее имя (default)]
				- [c/{AlphabeticalSortColor}:По алфавиту (A to Z)]
				- [c/{AlphabeticalBackwardsSortColor}:По алфавиту (Z to A)]
				- [c/{PointValueSortColor}:Значение баллов (Low to High)]
				- [c/{PointValueBackwardsSortColor}:Значение баллов (High to Low)]
				- [c/{CompletionSortColor}:Полный первый]
				- [c/{IncompletionSortColor}:Неполный первый]

				[c/{CycleColor}:Левая кнопка мыши - цикл вперед]
				[c/{CycleColor}:Правая кнопка мыши - цикл в обратном направлении]
				'''

			Starter: {
				Name: Стартер
				Subtitle: Новая игра
				Description:
					'''
					Вы только начинаете осваивать удивительный мир... ну, в общем, поедания всего мира за один раз? Не волнуйтесь, вы уже можете начинать перекусывать!
					Вот некоторые из первых вещей, которые вы должны сделать, чтобы убедиться, что вы и ваш кишечник максимально готовы к тому, чтобы в вас попало несколько хороших продуктов!
					'''
				FooterAdvice:
					'''
					[c/{$Mods.V2.CommonColorCodes.DoSomething}:Starter Advice:]
					Если более впечатляющие подвиги кажутся вам слишком сложными, помните, что прогресс за пределами pred-игры тоже важен! Старайтесь соблюдать здоровый баланс между прогрессом в pred и обычным прогрессом, пока не убедитесь, что можете пировать в свое удовольствие.
					'''
				UnlockCondition: начать игру

				FirstLivePrey: {
					Name: Первый химус

					Description: {
						Default:
							'''
							Съешьте и переварите свою первую живую добычу.
							"Все мы с чего-то начинаем".
							'''
						Clarification:
							'''
							Съешьте и переварите любого NPC (моба или жителя города).
							Чтобы проглотить NPC таким образом, нажмите клавишу *Проглотить*, находясь рядом с ним.
							Если вы не можете проглотить NPC, убедитесь, что их размер не превышает возможности вашего желудка или глотки.
							'''
					}
				}

				FirstItemEaten: {
					Name: Провожу инвентаризацию

					Description: {
						Default:
							'''
							Извлеките что-то из своего обычного инвентаря в свой внутренний "инвентарь".
							'Просто не мог дождаться, пока ты найдешь более вкусную закуску, чтобы проглотить, да?'
							'''
						Clarification:
							'''
							Съешьте предмет. Переваривание необязательно.с
							Чтобы проглотить предмет, наведите курсор на него в инвентаре и нажмите клавишу *Проглотить предмет*.
							Если вы не можете проглотить предмет, убедитесь, что он не больше, чем может выдержать ваш желудок или глотка.
							Некоторые предметы (например, кристаллы жизни и маны, живность) можно проглотить по левому щелчку мыши, если во время их использования удерживать привязку клавиши *Проглотить предмет*.
							Некоторые предметы (например, "обычная" еда и напитки) заставляют вас проглотить их при употреблении.
							'''
					}
				}

				FirstDrink: {
					Name: Освежающий напиток

					Description: {
						Default:
							'''
							Выпей немного воды.
							Даже самым лучшим хищникам время от времени нужно выпить чего-нибудь холодненького! Вы даже можете почаще есть морепродукты, пока пьете!
							'''
						Clarification:
							'''
							Выпей воду из плитки.
							Чтобы пить жидкости прямо из мира, погрузитесь в них и удерживайте клавишу *Проглотить*.
							Некоторые жидкости могут представлять для вас опасность, если вы выпьете их без должной подготовки.
							'''
					}
				}
			}

			Beginner: {
				Name: Новичкам
				Subtitle: Ранний и средний пре-хардмод
				Description:
					'''
					Итак, вы уже знаете основы, но все еще существует бесконечное множество сочных, аппетитных кусков мяса, в которые вы можете вонзить свои жемчужные белки, пока они погружаются в ваш кишечник.
					Постарайтесь позавтракать несколькими блюдами, чтобы помочь себе привыкнуть глотать и переваривать большие и/или более жесткие блюда.
					'''
				FooterAdvice:
					'''
					[c/{$Mods.V2.CommonColorCodes.DoSomething}:Beginner Advice:]
					Не забудьте потратить очки статов, которые вы получаете за выполнение целей в главном меню статов предов! У каждого стата pred есть свои преимущества, если вкладывать в него очки. Иногда вы сможете получить постоянные баффы к этим статам!
					'''
				UnlockCondition: выполнить все 3 цели начального этапа

				SwallowAnyFurniture: {
					// Name: Interior Decorator I

					Description: {
						/* Default:
							'''
							Decorate your tummy's insides with a piece of furniture!
							'A very touchy job, and one liable to get you glorped at any point, but the pay's really nice if you can do it well.'
							''' */
						// Clarification: Swallow any piece of furniture.
					}
				}

				EatManEater: {
					// Name: Man Eating

					Description: {
						/* Default:
							'''
							Enter the Jungle and show a Man Eater who's better at eating!
							'Would that make you a Man Eater Eater?'
							''' */
						// Clarification: Eat and digest a Man Eater.
					}
				}

				EatGoldCritter: {
					Name: Позолоченные кишки

					Description: {
						Default:
							'''
							Отведайте изысканные блюда местной кухни и пообедайте маленьким золотым существом.
							Ты уверен, что сможешь переварить такую дорогую еду... ...о, это уже пудинг".
							'''
						Clarification:
							'''
							Съешьте и переварите любую золотую живность.
							Золотые твари имеют редкий шанс появиться вместо своих обычных собратьев.
							'''
					}
				}

				EatAngyFlower: {
					Name: Веганский вариант

					Description: {
						Default:
							'''
							Пресеките гневный одуванчик в зародыше и попробуйте более здоровый вариант, чем обычный (шучу, ходячее, говорящее МЯСО - самый здоровый вариант из всех существующих).
							'Некоторые хищники настаивают на том, чтобы никогда не есть невинных животных. Или других людей. К счастью, для таких хищников в изобилии имеется растительная и все еще очень вздорная пища'.
							'''
						Clarification:
							'''
							Съешьте и переварите сердитый одуванчик.
							Злые одуванчики можно найти и выследить только в особенно ветреный день.
							'''
					}
				}

				EatFlyingFish: {
					// Name: Simple Sky Fishing

					Description: {
						/* Default:
							'''
							Hook a flying fish and reel it in(to your gut) to learn the basics of sky fishing.
							'It's a really fun sport once you get past the fact that fish can fly at all. How, you ask? Better not to think about it.'
							''' */
						/* Clarification:
							'''
							Eat and digest a Flying Fish.
							Flying Fish are fairly common, but only come swimming through the air to see your hook when it's raining.
							''' */
					}
				}

				EatSnowFlinx: {
					Name: Он был таким пушистым!

					Description: {
						Default:
							'''
							Проглотите снежного флинкса из глубины тундровых пещер.
							'Мех, честно говоря, просто щекочет горло, когда спускаешься вниз, что может быть неприятно... Но когда он у тебя в животе, это очень комфортно. Это как глотать огромную подушку, которая некоторое время двигается в животе'.
							'''
						Clarification:
							'''
							Съешьте и переварите снежный флинкс.
							Снежные флинки иногда появляются в Подземной тундре.
							-------------------------
							Ладно, пора рассказать: раньше у этих ублюдков было самое отвратительное состояние спавна, известное человеку. Они всегда спавнились в Подземной тундре. Но только на блоках, которые на самом деле не относятся к этому биому (например, все, из чего сделаны дома в бореальном лесу). Сказать, что это превращало их в кошмар, значит преуменьшить в полтора раза. Сейчас они стали менее тупыми, так что я бы на вашем месте не слишком беспокоился.

							'''
					}
				}

				Eat3DifferentSlimes: {
					Name: Гелевый живот

					Description: {
						Default:
							'''
							В вас сразу же забурлит куча вкусной слизи разных цветов.
							'Отличный источник сахара!... очень огнеопасный и посредственный сахар, но все же!'
							'''
						Clarification:
							'''
							Одновременно переваривайте 3 или более разных врагов типа слизь.
							Все враги, засчитанные для достижения *Желатиновое мировое турне*, засчитываются и для этого достижения.
							'''
					}
				}

				EatPinky: {
					Name: Слишком сладко, чтобы жить

					Description: {
						Default:
							'''
							Положите немного Пинки в рот и позвольте ему оказаться на ваших бедрах.
							'Маленькая штучка по вкусу напоминает сахарную вату, и она достаточно мала, чтобы ее мог проглотить практически каждый! Как можно не съесть это маленькое лакомство на месте?'
							'''
						Clarification:
							'''
							Съешьте и переварите Пинки.
							Пинки - это редкая розовая слизь, которая редко появляется в поверхностных лесах.
							'''
					}
				}

				EatGhost: {
					Name: Призрачный желоб

					Description: {
						Default:
							'''
							У вас есть призрак, который пытается вас преследовать? Заставьте их вместо этого преследовать ваш живот.
							'Кого ты собираешься проглотить?'
							'''
						Clarification:
							'''
							Съешьте и переварите Призрака.
							Призраки преследуют кладбища независимо от времени и могут прийти за вами, когда вы разбиваете надгробные камни.
							Когда время года особенно жуткое и осень в самом разгаре, они также могут иногда появляться в пещерах.
							'''
					}
				}

				EatHelpfulFairy: {
					Name: Второе правило хищничества

					Description: {
						Default:
							'''
							Спустите фею, которая в какой-то момент привела вас к сокровищам.
							'Феи - это еда, а не друзья.'
							'''
						Clarification:
							'''
							Съешьте и переварите Фею, которая пытается привести вас к сокровищам. Цвет не имеет значения.
							Феи могут появляться и над землей, но только те, которые редко встречаются вам в пещерах без желудка, могут попытаться помочь вам найти сокровища, чтобы побаловать себя.
							'''
					}
				}

				EatFirstLifeCrystal: {
					Name: Конфеты с полезными камнями

					Description: {
						Default:
							'''
							Перекусите кристаллом жизни, чтобы немного повысить выносливость организма.
							'Вкус вишни.'
							'''
						Clarification:
							'''
							Съешьте и переварите Кристалл Жизни.
							Кристаллы жизни иногда встречаются в пещерах, их можно использовать или съесть, чтобы увеличить максимальный запас здоровья.
							'''
					}
				}

				EatFirstManaCrystal: {
					Name: Волшебно вкусно

					Description: {
						Default:
							'''
							Перекусите кристаллом жизни, чтобы усилить свой магический потенциал.
							'По вкусу напоминает голубую малину.'
							'''
						Clarification:
							'''
							Съешьте и переварите кристалл маны.
							Кристаллы маны иногда встречаются в пещерах, их можно использовать или съесть, чтобы увеличить максимальный запас маны.
							'''
					}
				}

				EquipCharm: {
					// Name: Lunchy Charm

					Description: {
						/* Default:
							'''
							Get a hold of a charm that can help you alleviate your tummy's troubles.
							'Even the greediest preds need some help now and again! That's what charms are for!'
							''' */
						/* Clarification:
							'''
							Find and equip a charm for the first time.
							Charms are the primary predatory accessory you'll find in your travels, with many of them having powerful effects that help with a specific aspect of gorging yourself on the world. They can be equipped in your normal accessory slots, just as with anything else.
							''' */
					}
				}

				SleepSpeedsDigestion: {
					Name: Пищеварительный сон

					Description: {
						Default:
							'''
							Поспите немного в кровати, чтобы лучше переварить большой обед.
							'Всем известно, что хороший, долгий сон - это способ №1 превратить и друзей, и врагов в более пышные животы после столь тяжелой работы по их поеданию!'
							'''
						Clarification: Ложитесь в постель с животом весом 0,75 или больше и спите в ней до тех пор, пока живот не опустеет.
					}
				}

				StomachButterflies: {
					// Name: A Pang of Anxiety

					Description: {
						/* Default:
							'''
							Snack on some butterflies. Don't they tickle in there?
							'How does the saying go again...?'
							''' */
						// Clarification: Have 3 or more Butterflies in your stomach at once.
					}
				}

				TooFull: {
					Name: Переполненный

					Description: {
						Default:
							'''
							Оставайтесь на максимальной мощности или около нее в течение целой минуты.
							'Глаза больше, чем живот, да? Такое случается с каждым новичком, и не зря. Трудно иногда держать себя в руках, когда вокруг столько толстого, сочного мяса...'
							'''
						Clarification: Оставайтесь в состоянии 90% наполненности или выше в течение как минимум 60 секунд.
					}
				}

				DrinkHoney: {
					Name: Восстанавливающий напиток

					Description: {
						Default:
							'''
							Выпейте немного меда.
							'Всему хорошему приходит конец... в таком животике, как ваш. Так получилось, что в меде слишком много всего хорошего, чтобы не превратиться в жир на животе. Он вкусный, он восхитительно жирный, он прекрасно насыщает вас... он даже дает вам немного больше здоровья, когда вы его расплавляете!'
							'''
						Clarification: Выпейте плитку меда.
					}
				}

				Calamity: {
					EatCrawler: {
						Name: Хрустящая гусеница

						Description: {
							Default:
								'''
								Проглотите и булькните гусеницу в пещерах.
								'Эти *маленькие* ребята блестят и приятно хрустят, и остается только удивляться, как они до сих пор так многочисленны, когда вокруг полно хищников, жаждущих драгоценных камней, таких как вы.'
								'''
							Clarification: Съешьте и переварите любого самоцветного или кристаллического ползуна.
						}
					}

					EatFearlessGoldfish: {
						Name: Полное знамение

						Description: {
							Default:
								'''
								Успокойте глупые амбиции золотой рыбки (с помощью вашего голодного желудка).
								'Пламя, вдохновляющее, в мгновение ока погасшее в прожорливой глотке благодати.'
								'''
							Clarification: Съешьте и переварите бесстрашного воина золотой рыбки.
						}
					}
				}
			}

			Amateur: {
				Name: Любитель
				Subtitle: Средний и поздний пре-хардмод
				Description:
					'''
					Вы уже начинаете понимать, что такое еда. К этому моменту вы должны быть в состоянии уложить в пакет как минимум еще одного человека вашего размера... если не больше.
					Не стесняйтесь, начните охотиться за блюдами из этого раздела, чтобы еще больше натренировать свой организм; питаться только одним человеком за один раз просто не получится!
					'''
				FooterAdvice:
					'''
					[c/{$Mods.V2.CommonColorCodes.DoSomething}:Amateur Advice:]
					Многие цели могут быть недоступны для просмотра до тех пор, пока вы не завершите их или не посетите область, к которой относится проверка их завершения. Кроме того, некоторые цели могут появляться только при активности определенных NPC, после победы над определенными боссами или во время определенных погодных явлений.
					'''
				UnlockCondition: победить Глаз Ктулху, Пожирателя миров или Мозг Ктулху

				EatHarpy: {
					Name: Вкуснятина для пальцев

					Description: {
						Default:
							'''
							Угощайтесь гарпией, пойманной с неба.
							'По вкусу напоминает курицу. Точнее, грудки и бедра.'
							'''
						Clarification:
							'''
							Съешьте и переварите гарпию.
							Гарпии очень часто спаунятся в слое неба.
							Обратите внимание, что до Хардмода они не будут появляться вблизи горизонтального центра мира.
							'''
					}
				}

				EatNymph: {
					Name: Девушка в пищеварении

					Description: {
						Default:
							'''
							Назовите голодную нимфу так, чтобы она не съела вас первой.
							'Может, вы сделаете шарф из того, что осталось от ее волос?'
							'''
						Clarification:
							'''
							Съешьте и переварите нимфу.
							Нимфы - редкие мобы, которых можно встретить в нижних пещерах.
							'''
					}
				}

				EatBrideAndGroom: {
					Name: "'До самой смерти..."

					Description: {
						Default:
							'''
							Воссоедините жениха и невесту... в виде вашей еды.
							'Теперь они могут остаться вместе навсегда!... хотя твой живот, похоже, несколько жалуется на эту идею.'
							'''
						Clarification:
							'''
							Переваривайте *Жениха* и *Невесту* одновременно.
							Оба моба - редкие существа, которые выходят к своей жертве только во время Кровавой луны.
							Имейте в виду, что, поскольку оба являются зомби, при поедании/переваривании они вызовут у вас пищевое отравление.
							'''
					}
				}

				EatSquid: {
					Name: Настроение кальмаров

					Description: {
						Default:
							'''
							Найдите в океане редкого кальмара и угостите себя вкуснейшими кальмарами.
							[c/{$Mods.V2.CommonColorCodes.ThomasCommentary}:смеяться, черт тебя побери]
							'''
						Clarification:
							'''
							Съешьте и переварите кальмара.
							Кальмары редко выходят из укрытия в океане.
							'''
					}
				}

				EatMaxLifeAndManaCrystals: {
					Name: Достигнуто (пока)

					Description: {
						Default:
							'''
							Закусывайте большим количеством кристаллов жизни и маны, чтобы пополнить максимум здоровья и маны (на данный момент).
							'Вы уже чувствуете себя достаточно сильным, чтобы перекусить живой добычей, или вам нужно еще немного?'
							'''
						Clarification:
							'''
							Съешьте и переварите кристалл жизни или кристалл маны и благодаря этому достигните максимума для обоих.
							Съев и переварив кристалл жизни или маны, когда ваше здоровье и мана уже максимальны, вы также достигнете этой цели.
							'''
					}
				}

				Cheapskate: {
					Name: Леденец женского размера

					Description: {
						Default:
							'''
							Найдите медсестру, чтобы обмануть ее плату за услуги и вылечиться бесплатно (и получить при этом бесплатный обед).
							'Именно то, что заказывал пациент.'
							'''
						Clarification: Пока вы ранены/ослаблены настолько, что традиционное исцеление у медсестры обойдется вам не менее чем в 1 золотой и 20 серебряных, съешьте и переварите медсестру.
					}
				}

				DigestWithVoodoo: {
					Name: Ужин на расстоянии

					Description: {
						Default:
							'''
							С удовольствием мульчируйте вкусных горожан... не проглатывая их.
							'Что это за вуду?'
							'''
						Clarification:
							'''
							Съешьте и переварите куклу вуду, соответствующую живым жителям города.
							Кукла вуду ваша или нет, не имеет значения.
							'''
					}
				}

				CatchFallingStar: {
					Name: Желание в животе

					Description: {
						Default:
							'''
							Пусть звезда, упавшая с небес, приземлится в вашем животе.
							'Говорят, что если переварить кусочек неба над головой, то можно обрести великую силу магического полета! А еще говорят, что от него можно отравиться радиацией... но мы же не видим, как он превращается в жир на животе, правда?'
							'''
						Clarification: Проглотите упавшую звезду, пока она еще падает с неба.
					}
				}

				Eat5Swords: {
					Name: Глотатель мечей

					Description: {
						Default:
							'''
							Проглотите несколько разных мечей и добавьте каждый из них к набивке на животе.
							'Я не думаю, что это то, что должно означать...'
							'''
						Clarification:
							'''
							Съешьте и переварите как минимум 5 различных мечей, которые есть в ванильной игре или добавлены в Voraria: Second Course.
							Мечи, для изготовления которых так или иначе использовались другие мечи, также получат кредит на все свои составные части.
							Мечи, которые засчитываются для достижения этой цели, будут иметь значок меча в боковой части своего тултипа.
							'''
					}
				}

				DrinkLava: {
					Name: Восстанавливающий напиток

					Description: {
						Default:
							'''
							Безопасно выпейте немного лавы. Вам понадобится что-нибудь, чтобы защитить живот от сильного жара такого расплавленного напитка, как лава.
							'Только будьте осторожны и не пейте слишком много: лава очень калорийна, ведь она тоньше меда, а вы точно не из тех демонов, которые регулярно пьют ее галлонами...'
							'''
						Clarification:
							'''
							У вас активен эффект, предотвращающий урон от лавы. К допустимым источникам относятся:
							- Лавовые чары и тинктуры
							- Зелье обсидиановой кожи
							Проглотите плитку лавы.
							'''
					}
				}

				EatLargeGem: {
					// Name: Pristine Pudge

					Description: {
						/* Default:
							'''
							Churn a giant gemstone into some grade-A ass fat.
							'Gemstones are really the best sorts of meals...tough as a rock, sky-high in calories, and expensive as all hell! Just imagine, all that unadulterated pristine WEALTH, steadily turned into nothing but a slew of caloric sludge ready to fatten up your frame...~'
							''' */
						/* Clarification:
							'''
							Eat and digest a Large Gem.
							Large Gems can be created with a great number of their not-large counterparts.
							Be aware that gemstones and their large variants universally resist unimproved acids --- you'll need a potion or similar to increase your acid tier enough to digest them.
							''' */
					}
				}

				LongGolf: {
					// Name: Hole in Tum

					Description: {
						/* Default:
							'''
							Hit a golf ball into a faraway predator.
							'Uh... did i win?'
							''' */
						// Clarification: With a golf club, hit a golf ball into a predator that is 150+ tiles away from you.
					}
				}
			}

			Intermediate: {
				Name: Промежуточный
				Subtitle: Конец пре-хардмода / ранний хардмод
				Description:
					'''
					Отлично. Вы научились глотать то, что больше вас самих; пора обедать!
					Эти последние блюда должны обеспечить вашему животу большой шведский стол, пока вы заняты подготовкой к еще более крупным закускам!
					'''
				FooterAdvice:
					'''
					[c/{$Mods.V2.CommonColorCodes.DoSomething}:Intermediate Advice:]
					Следите за [c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:кислотным ярусом]. Некоторые из ваших самых вкусных жертв могут быть совершенно невосприимчивы к обычным кислотам, а это значит, что вы не сможете превратить их в жир для живота! Поэтому будьте начеку, ищите способы повысить уровень кислоты; некоторые из них могут быть связаны с прогрессом (в будущих обновлениях)...
					'''
				UnlockCondition: defeat Skeletron

				EatMimic: {
					Name: Просчет Мимика

					Description: {
						Default:
							'''
							Съешьте мимика (прежде чем он успеет сделать то же самое с вами).
							'Теперь вы просто храните его запасы в своем животе, который сам по себе может считаться кладом, хотя и только для пищи, которую ваш организм еще не переварил. Можно ли это считать кладоискательством...?'
							'''
						Clarification:
							'''
							Ешьте и переваривайте любые виды мимиков.
							Мимики появляются только в режиме Хардмода, и их можно найти на разных высотах под землей.
							Более крупные мимики могут появляться в запятнанных областях, они гораздо сильнее, но у них есть свои собственные дропы.
							'''
					}
				}

				EatSandElemental: {
					Name: Укусить пыль

					Description: {
						Default:
							'''
							Проглотите песчаного элементаля и добавьте его к своей фигуре.
							'Все ненавидят песок. Он крупнозернистый, грубый, и в нем можно увязнуть. Он даже попадает на стенки вашего желудка, когда вы глотаете красивую девушку, сделанную из него. К счастью, ваш желудок может довольно быстро решить эту проблему, переплавив даже самые мелкие песчинки в гладкий, мягкий, хлюпающий целлюлит.'
							'''
						Clarification:
							'''
							Съешьте и переварите песчаного элементаля.
							Песчаные элементали - редкие крупные дамы, которые появляются во время песчаных бурь в пустыне в режиме Хардмода.
							'''
					}
				}

				EatIceGolem: {
					Name: Ходячее мороженое

					Description: {
						Default:
							'''
							Выращенный из льда голем.
							'Если вдуматься, он действительно таков. Очень высокий, довольно тощий, достаточно широкий, чтобы присосаться к нему на время, пока вы его глотаете, немного тает во рту... и на вкус совсем как кубик льда!'
							'''
						Clarification:
							'''
							Съешьте и переварите ледяного голема.
							Ледяные големы встречаются только в режиме Хардмода, где свирепые метели бушуют в заснеженной тундре.
							'''
					}
				}

				EatShark: {
					Name: Съеденная акула

					Description: {
						Default:
							'''
							Привлеките акулу, чтобы перевернуть ситуацию.
							'Ох, ха-ха-ха!'
							'''
						Clarification:
							'''
							Съешьте и переварите Акулу.
							Акулы обычно нерестятся в океане в любое время.
							'''
					}
				}

				EatFallenAngel: {
					// Name: Sanctum of Gastric Grace

					Description: {
						/* Default:
							'''
							Gobble up an angel warped by the evils of the world, cleansing them of their ailment in the process.
							'A massive meal from on high, seasoned with the aftertastes of sin...a delicious treat, aren't they?'
							''' */
						/* Clarification:
							'''
							Eat and digest a Fallen Angel.
							Fallen Angels rarely appear in the Corruption and Crimson, a bit more commonly in the caves of these accursed places, and will try to cram themselves into you if you have enough space to hold them; if not, they will cram you and themselves into the nearest predator, if possible.
							''' */
					}
				}

				HoardGemCritters: {
					Name: Игристые искры

					Description: {
						Default:
							'''
							Соберите в своем животе множество различных драгоценных камней.
							'Такие блестящие блюда заслуживают того, чтобы быть жирными в кишечнике! Держу пари, что зоолог никогда не рассказывал вам о них...'
							'''
						Clarification:
							'''
							Съешьте 7 разных самоцветов одновременно. Нахождение в середине процесса переваривания считается, но не обязательно.
							Самоцветные криттеры, состоящие из кроликов и белок, могут выходить на поверхность, где бы ни жили жители города под землей.
							Имейте в виду, что самоцветные криттеры повсеместно сопротивляются неулучшенным кислотам - вам понадобится зелье или что-то подобное, чтобы повысить уровень кислоты настолько, чтобы переварить их.
							'''
					}
				}

				GivePromethiaBellyBath: {
					Name: Божественная ванна для живота
					Description:
						'''
						Выпейте значительное количество самодельной святой воды, а затем съешьте Прометию, чтобы побаловать ее хорошей ванной.
						'Это не так хорошо, как те желудки и сауны, которые она знает по дому, но, тем не менее, ей нравится этот опыт! Каким-то образом она дала вам за это несколько очков статистики. Как, спросите вы? Очень просто.

						Не стоит недооценивать соблазнительную природу и скрытые магические способности преданной шлюхи с кишками.'
						'''
				}

				BoulderBelly: {
					Name: Рок в роллах

					Description: {
						Default:
							'''
							Глотайте варево, чтобы оно не расплющило вас, как большой и сочный блин, которым может угостить вас голодный хищник.
							[c/{Mods.V2.CommonColorCodes.ThomasCommentary}:В моей голове эта шутка звучала гораздо смешнее.]
							'''
						Clarification: Съешьте и переварите валун.
					}
				}

				EatCouch: {
					// Name: Couch Potato

					Description: {
