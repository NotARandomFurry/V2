						SetBonus: {
							// Short: Boosts natural health regeneration, moreso in daylight
							// Long: "[c/{$Mods.V2.CommonColorCodes.PositiveEffect}:Increases natural health regeneration] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:5%]; this is [c/{$Mods.V2.CommonColorCodes.PositiveEffect}:doubled] when [c/{$Mods.V2.CommonColorCodes.DoSomething}:exposed to sunlight]."
						}
					}

					Gold: {
						Head: {
							/* Short:
								'''
								Increases magic damage by {GoldCrownMagDMGUp}
								Increases mana efficiency by {GoldCrownManaEffUp}
								{$Mods.V2.ItemTooltip.Generic.HoldForInDepthFunctionAndLore}
								''' */
							/* Long:
								'''
								[c/{$Mods.V2.CommonColorCodes.PositiveEffect}:Increases magic damage] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{GoldCrownMagDMGUp}].
								[c/{$Mods.V2.CommonColorCodes.PositiveEffect}:Increases mana efficiency] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{GoldCrownManaEffUp}].
								Has no special effects when eaten.
								''' */
							/* Flavor:
								'''
								A crown forged with gold and rubies, molded into a form useful for battle.
								Crowns such as these were often used by rulers of times long past, denoting their status as both royalty and magically inclined. Of course, nowadays, those denotations are moot, as virtually everyone has readily-available access to at least basic magics, and royalty is often shown through predatory prowess and ruling capability rather than mere gaudiness. Nonetheless, they're still a common implement on the heads of military caster specialists to improve their efficiency in battle.
								''' */
						}

						OldHead: {
							/* Short:
								'''
								Increases magic damage by {GoldOldHeadMagDMGUpPercent} + {GoldOldHeadMagDMGUpFlat}
								Increases mana efficiency by {GoldOldHeadManaEffUp}
								{$Mods.V2.ItemTooltip.Generic.HoldForInDepthFunctionAndLore}
								''' */
							/* Long:
								'''
								[c/{$Mods.V2.CommonColorCodes.PositiveEffect}:Increases magic damage] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{GoldOldHeadMagDMGUpPercent} + {GoldOldHeadMagDMGUpFlat}].
								[c/{$Mods.V2.CommonColorCodes.PositiveEffect}:Increases mana efficiency] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{GoldOldHeadManaEffUp}].
								Has no special effects when eaten.
								''' */
							/* Flavor:
								'''
								An old style of golden helmet similar to the type used back in the Grand Avarsician Civil War by understudies of then-rebel-leader Mary Caldera.
								While not as flexible or maw-friendly as the gilded tiaras of modern casting militia, there were still mechanisms in the helmet to allow somewhat-easier consumption of defeated foes.
								''' */
						}

						OldOldHead: {
							/* Short:
								'''
								Increases magic damage by {GoldOldOldHeadMagDMGUpPercent} + {GoldOldOldHeadMagDMGUpFlat}
								Increases magic crit chance by {GoldOldOldHeadMagCritUp}
								Increases mana efficiency by {GoldOldOldHeadManaEffUp}
								{$Mods.V2.ItemTooltip.Generic.HoldForInDepthFunctionAndLore}
								''' */
							/* Long:
								'''
								[c/{$Mods.V2.CommonColorCodes.PositiveEffect}:Increases magic damage] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{GoldOldOldHeadMagDMGUpPercent} + {GoldOldOldHeadMagDMGUpFlat}].
								[c/{$Mods.V2.CommonColorCodes.PositiveEffect}:Increases magic crit chance] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{GoldOldOldHeadMagCritUp}].
								[c/{$Mods.V2.CommonColorCodes.PositiveEffect}:Increases mana efficiency] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{GoldOldOldHeadManaEffUp}].
								Has no special effects when eaten.
								''' */
							/* Flavor:
								'''
								An archaic style of golden helmet dating back to the origins of what would become Avarsici.
								This resembles some of the first golden helmets ever forged for war. Casters at the time were of limited supply, due to not many people knowing magic as intricately as the common person does now, so they needed items which could very well protect their head while still allowing them to defend themselves with their appetites.
								''' */
						}

						Chest: {
							/* Short:
								'''
								Increases magic projectile velocity {GoldDressMagDMGUp}
								Increases mana efficiency by {GoldDressManaEffUp}
								{$Mods.V2.ItemTooltip.Generic.HoldForInDepthFunctionAndLore}
								''' */
							/* Long:
								'''
								[c/{$Mods.V2.CommonColorCodes.PositiveEffect}:Increases magic damage] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{GoldDressMagDMGUp}].
								[c/{$Mods.V2.CommonColorCodes.PositiveEffect}:Increases mana efficiency] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{GoldDressManaEffUp}].
								Has no special effects when eaten.
								''' */
							/* Flavor:
								'''
								A long chainmail-esque dress, shaped from gold and given rubies for accents.
								Chain dresses are a common implement for military types, especially amongst fancier-feeling foot soldiers --- they provide equal parts fashion and utility, able to easily drape over a belly full of tasty enemy meat to defend it from attacks while it digests its quarry. Gold in particular is often found adorning the magically inclined due to the metal's mana-conductivity.
								''' */
						}

						Legs: {
							/* Short:
								'''
								Increases mana efficiency by {GoldSabsManaEffUp}
								Increases mana regen while moving by {GoldSabsMovingManaRateUp}
								{$Mods.V2.ItemTooltip.Generic.HoldForInDepthFunctionAndLore}
								''' */
							/* Long:
								'''
								[c/{$Mods.V2.CommonColorCodes.PositiveEffect}:Increases mana efficiency] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{GoldSabsManaEffUp}].
								[c/{$Mods.V2.CommonColorCodes.PositiveEffect}:Increases mana regen rate while moving] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{GoldSabsMovingManaRateUp}].
								Has no special effects when eaten.
								''' */
							/* Flavor:
								'''
								A pair of fanciful combat boots melded from gold and finished with rubies.
								Boots like these greatly ease traveling over rocky terrain, and can easily score some points at the local infantry base looks contest, too. That said, they're usually not forged from gold --- such boots as these should only be on backline casters who can afford steadying themselves with only one or two enemies to a gut and need the extra ease of casting.
								''' */
						}

						SetBonus: {
							/* Short:
								'''
								A small, hungry gilded prince floats next to you, conferring a desire for coins to your magic weapons
								'For and having only the most refined of tastes'
								''' */
							/* Long:
								'''
								Calls forth a [c/{$Mods.V2.BasicColorCodes.Gold}:miniature gold prince] to float next to you.
								[c/{$Mods.V2.CommonColorCodes.DoSomething}:While active,] the [c/{$Mods.V2.BasicColorCodes.Gold}:prince] [c/{$Mods.V2.CommonColorCodes.PositiveEffect}:confers the following buffs] to your magic weapons:
								[c/{$Mods.V2.BasicColorCodes.Gray}:> ][c/{$Mods.V2.CommonColorCodes.DoSomething}:+{GoldPrinceMidasChance} chance] [c/{$Mods.V2.BasicColorCodes.Gray}:to] [c/{$Mods.V2.CommonColorCodes.DealDamage}:inflict Midas] [c/{$Mods.V2.BasicColorCodes.Gray}:on hit.]
								[c/{$Mods.V2.BasicColorCodes.Gray}:> ][c/{$Mods.V2.CommonColorCodes.DoSomething}:+{GoldPrinceMagDMGUp}] [c/{$Mods.V2.CommonColorCodes.DealDamage}:damage][c/{$Mods.V2.BasicColorCodes.Gray}:.]
								[c/{$Mods.V2.CommonColorCodes.DoSomething}:The first hit you take] while the [c/{$Mods.V2.BasicColorCodes.Gold}:prince] is active [c/{$Mods.V2.BasicColorCodes.Orange}:wounds him], rendering him unable to provide his bonuses for {GoldPrinceRecoverTime} seconds while he recovers.
								The [c/{$Mods.V2.BasicColorCodes.Gold}:prince] will [c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:devour] the first enemy that attempts to deal contact damage to you, [c/{$Mods.V2.CommonColorCodes.PositiveEffect}:nullifying the hit].
								[c/{$Mods.V2.BasicColorCodes.DarkGray}:> Swallow capacity: ][c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:{GoldPrinceSwallowCapacity}]
								[c/{$Mods.V2.BasicColorCodes.DarkGray}:> Stomach capacity: ][c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:{GoldPrinceStomachCapacity}]
								[c/{$Mods.V2.BasicColorCodes.DarkGray}:> Digestion tick damage: ][c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:{GoldPrinceDigestDamage}]
								[c/{$Mods.V2.BasicColorCodes.DarkGray}:> Digestion tick rate: ][c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:{GoldPrinceDigestRate}/sec]
								[c/{$Mods.V2.BasicColorCodes.DarkGray}:> Absorption rate: ][c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:{GoldPrinceAbsorbRate}/min]
								[c/{$Mods.V2.CommonColorCodes.DoSomething}:While digesting an enemy,] the [c/{$Mods.V2.BasicColorCodes.Gold}:prince] will [c/{$Mods.V2.CommonColorCodes.PositiveEffect}:confers the following buffs to you] instead of his normal bonuses:
								[c/{$Mods.V2.BasicColorCodes.Gray}:> ][c/{$Mods.V2.CommonColorCodes.DoSomething}:+{GoldPrinceDigestingRegen}/sec] [c/{$Mods.V2.CommonColorCodes.Heal}:health regeneration][c/{$Mods.V2.BasicColorCodes.Gray}:.]
								[c/{$Mods.V2.BasicColorCodes.Gray}:> ][c/{$Mods.V2.CommonColorCodes.DoSomething}:+{GoldPrinceDigestingDefense}] [c/{$Mods.V2.CommonColorCodes.PositiveEffect}:defense][c/{$Mods.V2.BasicColorCodes.Gray}:.]
								The [c/{$Mods.V2.BasicColorCodes.Gold}:prince] can be [c/{$Mods.V2.CommonColorCodes.NegativeVoreEffect}:eaten] if enemies prioritize him.
								[c/{$Mods.V2.BasicColorCodes.DarkGray}:> Size: ][c/{$Mods.V2.CommonColorCodes.NegativeVoreEffect}:{GoldPrinceSize}]
								[c/{$Mods.V2.BasicColorCodes.DarkGray}:> Health: ][c/{$Mods.V2.CommonColorCodes.NegativeVoreEffect}:{GoldPrinceMaxHealth}]
								If he is eaten and digested, he will provide no bonuses for 1 minute --- after this time has passed, he will reform at your side and confer his bonuses again.
								If he is eaten and digested by you, he will instead provide the same bonuses as if he were digesting something until he reforms, and will not reform until fully digested.
								''' */
						}
					}

