									[c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:Increases TUM] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{TUM}].
									[c/{$Mods.V2.CommonColorCodes.NegativeEffect}:Decreases movement speed] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{SPD}%].
