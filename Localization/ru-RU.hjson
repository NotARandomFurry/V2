									This bonus only applies once. Eating this item after you have already done so [c/{$Mods.V2.CommonColorCodes.NegativeEffect}:will have no further effect].
									''' */
								/* Flavor:
									'''
									[c/{$Mods.V2.CommonColorCodes.CloverQuote}:"The jungle? Reminds me of the time where I drank like three gallons]
									[c/{$Mods.V2.CommonColorCodes.CloverQuote}:of honey and then got all sticky... Took a while to crawl out of the hive." -Clover]
									''' */
							}

							BiomeJujuSky: {
								/* Short:
									'''
									Decreases stomach weight
									Increases movement speed & jump height
									If eaten for the first time, permanently gain slight buffs related to this juju's effects
									{$Mods.V2.ItemTooltip.Generic.HoldForInDepthFunctionAndLore}
									''' */
								/* Long:
									'''
									[c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:Decreases stomach weight] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{WeightReduce}%].
