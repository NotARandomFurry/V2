		StatusEffects: {
			Vanilla: {
				Buffs: {
					/* Campfire.Description:
						'''
						[c/{$Mods.V2.CommonColorCodes.Heal}:Increases health regeneration] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{CampfireRegenFlat} HP/sec]. [c/7F7F7F:(Natural)]
						[c/{$Mods.V2.CommonColorCodes.Heal}:Increases base natural regeneration buildup speed] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{CampfireNaturalRegenBuildupSpeed}].
						[c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:Increases digestion tick rate and absorption rate] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{CampfireDigestionSpeedBonus}].
						'Everything's better with a nice, warm fire nearby'
						''' */
					/* HeartLantern.Description:
						'''
						[c/{$Mods.V2.CommonColorCodes.Heal}:Increases health regeneration] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{HeartLanternRegenFlat} HP/sec]. [c/7F7F7F:(Artificial)]
						'You feel a bit more lively than usual'
						''' */
					/* Honey.Description:
						'''
						[c/{$Mods.V2.CommonColorCodes.Heal}:Increases health regeneration] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{HoneyRegenFlat} HP/sec]. [c/7F7F7F:(Natural)]
						[c/{$Mods.V2.CommonColorCodes.Heal}:Increases the speed at which natural regeneration builds up] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{HoneyNaturalRegenBuildupSpeed}].
