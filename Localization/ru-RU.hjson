						SetBonus: {
							// Short: Boosts natural health regeneration, moreso in daylight
							// Long: "[c/{$Mods.V2.CommonColorCodes.PositiveEffect}:Increases natural health regeneration] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:5%]; this is [c/{$Mods.V2.CommonColorCodes.PositiveEffect}:doubled] when [c/{$Mods.V2.CommonColorCodes.DoSomething}:exposed to sunlight]."
						}
					}
				}

				Consumables: {
					Food: {
						ChickenNugget: {
							Short:
								'''
								{$Mods.V2.ItemTooltip.Generic.Food.Short}
								'Определенно содержит гарпию'
								{$Mods.V2.ItemTooltip.Generic.HoldForInDepthFunctionAndLore}
								'''
							Long: "{$Mods.V2.ItemTooltip.Generic.Food.Long}"
							Flavor:
								'''
								Часто для простоты их называют *куриными наггетсами*, но на самом деле эти котлетки из панированного, тщательно прожаренного мяса происходят от самых разных птиц и гарпий.
								Чаще всего их можно найти в детских блюдах в сетях быстрого питания или в разделе меню для маленьких в ресторанах; более зрелые люди обычно предпочитают хотя бы полные конечности хорошо приготовленного мяса, если они не глотают птицу целиком и живьем.
								'''
						}

						ChocolateChipCookie: {
							Short:
								'''
								{$Mods.V2.ItemTooltip.Generic.Food.Short}
								'Новый и усовершенствованный'
								{$Mods.V2.ItemTooltip.Generic.HoldForInDepthFunctionAndLore}
								'''
							Long: "{$Mods.V2.ItemTooltip.Generic.Food.Long}"
							Flavor:
								'''
								Одно из самых простых в выпечке видов печенья.
								Шоколадная крошка придает неоспоримо сладкий и аппетитный оттенок твердой основе обычного печенья.
								Можно легко экспериментировать с дополнительными ингредиентами, чтобы создать еще более вкусное печенье.
								'''
						}

						Fries: {
							Short:
								'''
								{$Mods.V2.ItemTooltip.Generic.Food.Short}
								'Эй, где кетчуп?'
								{$Mods.V2.ItemTooltip.Generic.HoldForInDepthFunctionAndLore}
								'''
							Long: "{$Mods.V2.ItemTooltip.Generic.Food.Long}"
							Flavor:
								'''
								Одна из самых распространенных вещей, которые можно сделать с картофелем, - это нарезать его на маленькие палочки и поджарить. Результат, довольно некреативно, называется партией картофеля фри.
								В зависимости от того, где вы найдете их в ресторанах, их могут подавать с самыми разными другими блюдами, например, с рыбой или гамбургерами.
								'''
						}

						GingerbreadCookie: {
							Short:
								'''
								{$Mods.V2.ItemTooltip.Generic.Food.Short}
								'На этот раз никаких сюжетных доспехов, еблан.'
								{$Mods.V2.ItemTooltip.Generic.HoldForInDepthFunctionAndLore}
								'''
							Long: "{$Mods.V2.ItemTooltip.Generic.Food.Long}"
							Flavor:
								'''
								Самое простое в приготовлении печенье. В нем не используются никакие завлекающие ингредиенты.
								В старые времена дополнительный ингредиент, добавленный в такое печенье, заставлял его становиться разумным и убегать от своих создателей. Свеетская культура до сих пор позволяет этим печеньям иметь свое собственное место (с ограничениями), но где же еще? Им некуда бежать, когда вокруг полно жаждущих сладостей хищников.
								Это одно из самых простых и наименее изысканных печений, испеченных с этим необычным ингредиентом.
								'''
						}

						PotatoChips: {
							Short:
								'''
								{$Mods.V2.ItemTooltip.Generic.Food.Short}
								'Также известны как чипсы'
								{$Mods.V2.ItemTooltip.Generic.HoldForInDepthFunctionAndLore}
								'''
							Long: "{$Mods.V2.ItemTooltip.Generic.Food.Long}"
							Flavor:
								'''
								Чипсы - не такой распространенный кулинарный выбор, как картофель фри, но все же часто используемый вариант применения картофеля в кулинарии.
								Как правило, они гораздо более хрустящие и рассыпчатые, чем картофель фри, что позволяет использовать их в качестве закуски в местах, где предпочитают хруст.
								'''
						}

						SugarCookie: {
							Short:
								'''
								{$Mods.V2.ItemTooltip.Generic.Food.Short}
								'Не из снега, как ни странно.'
								{$Mods.V2.ItemTooltip.Generic.HoldForInDepthFunctionAndLore}
								'''
							Long: "{$Mods.V2.ItemTooltip.Generic.Food.Long}"
							Flavor:
								'''
								Очень распространенное лакомство в Свеетии, так как сахар часто используется в кулинарии и выпечке.
								Обеспечивает много энергии, чтобы помочь пережить день в порциях или быстро подкрепиться в качестве одиночного перекуса.
								'''
						}
					}

					Potions: {
						Ale: {
							/* Short:
								'''
								Makes you tipsy while, and for a minute or two after, digesting
								While tipsy, you're better with melee combat and eating people; not as good with digesting them, though
								{$Mods.V2.ItemTooltip.Generic.HoldForInDepthFunctionAndLore}
								''' */
							/* Long:
								'''
								It's alcohol in a mug. What do you want me to say?
								Lucky you, not only are glass mugs super easy to digest, but the booze will spill over the top as it goes down your throat, too, so you'll feel the effects right away.

								While in a stomach, until fully digested, and for 1 minute and 30 seconds thereafter, [c/{$Mods.V2.CommonColorCodes.DoSomething}:inflicts the Tipsy debuff].
								This buff improves your melee capabilities and internal capacities, at the cost of some defense and some digestion rates.
								''' */
							// Flavor: A simple glass of ale. Most drunkands would swallow mugs like these by the pound with ale still in them, or even drink the kegs dry directly. Sometimes, they'd even swallow down the kegs themselves!
						}

						Healing: {
							Lesser: {
								/* Short:
									'''
