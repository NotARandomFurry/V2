						Shimmer: {
							/* Short:
								'''
								Increases swallow capacity, stomach capacity, acid strength and prey absorption rate
								If eaten for the first time, permanently gain slight buffs related to these effects
								{$Mods.V2.ItemTooltip.Generic.HoldForInDepthFunctionAndLore}
								''' */
							/* Long:
								'''
								[c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:Increases swallow capacity, stomach capacity, digestion damage and prey absorption rate] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{Stat}%].
								When eaten:
								- [c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:Permanently increases GLP, TUM, ACI & ABS] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{Perm}].
								This bonus only applies once. Eating this item after you have already done so [c/{$Mods.V2.CommonColorCodes.NegativeEffect}:will have no further effect].
								''' */
							/* Flavor:
								'''
								You listen close...
								...You hear "Terraria 1.4.4 OST - 'Aether'"
								''' */
						}

						Sky: {
							/* Short:
								'''
								Increases flight time
								Decreases stomach and body weight
								If eaten for the first time, permanently gain slight buffs related to these effects
								{$Mods.V2.ItemTooltip.Generic.HoldForInDepthFunctionAndLore}
								''' */
							/* Long:
								'''
								[c/{$Mods.V2.CommonColorCodes.PositiveEffect}:Increases flight time] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{Wing}%].
								[c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:Decreases stomach weight] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{Stat}%].
								[c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:Decreases body weight] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{Stat}%].
								When eaten:
								- [c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:Decreases stomach weight] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{Perm}%].
								- [c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:Decreases body weight] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{Perm}%].
								This bonus only applies once. Eating this item after you have already done so [c/{$Mods.V2.CommonColorCodes.NegativeEffect}:will have no further effect].
								''' */
							/* Flavor:
								'''
								You listen close...
								...You hear tinnitus.
								''' */
						}

						Snow: {
							/* Short:
								'''
								Increases max stomachache
								Decreases struggle damage
								If eaten for the first time, permanently gain slight buffs related to these effects
								{$Mods.V2.ItemTooltip.Generic.HoldForInDepthFunctionAndLore}
								''' */
							/* Long:
								'''
								[c/{$Mods.V2.CommonColorCodes.PositiveVoreEffect}:Increases max stomachache] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{Ache}%].
								[c/{$Mods.V2.CommonColorCodes.NegativeVoreEffect}:Decreases struggle damage] by [c/{$Mods.V2.CommonColorCodes.DoSomething}:{Str}%].
								When eaten:
